#!/bin/bash

# 1. Kontrollitakse, et kasutaja sisestas täpselt kolm argumenti
if [ "$#" -ne 3 ]; then
    echo "Viga: Palun sisesta täpselt 3 kordajat (A, B ja C)."
    echo "Kasutamine: $0 A B C"
    exit 1
fi

A=$1
B=$2
C=$3

# 2. Kontrollitakse, et kordaja A ei oleks 0
if [ $(echo "$A == 0" | bc -l) -eq 1 ]; then
    echo "Viga: Kordaja A ei saa olla 0 (tegemist pole ruutvõrrandiga)."
    exit 1
fi

# 3. Arvutatakse diskriminant: D = B^2 - 4AC
D=$(echo "$B * $B - 4 * $A * $C" | bc -l)

# 4. Kontrollitakse diskriminanti ja leiame lahendid
is_positive=$(echo "$D > 0" | bc -l)
is_zero=$(echo "$D == 0" | bc -l)

if [ "$is_positive" -eq 1 ]; then
    # Kaks reaalarvulist lahendit
    x1=$(echo "scale=10; (-($B) + sqrt($D)) / (2 * $A)" | bc -l)
    x2=$(echo "scale=10; (-($B) - sqrt($D)) / (2 * $A)" | bc -l)
    
    echo "Võrrandil on kaks reaalarvulist lahendit:"
    printf "x1 = %.5f\n" "$x1"
    printf "x2 = %.5f\n" "$x2"

elif [ "$is_zero" -eq 1 ]; then
    # Üks reaalarvuline lahend
    x=$(echo "scale=10; (-($B)) / (2 * $A)" | bc -l)
    
    echo "Võrrandil on üks reaalarvuline lahend:"
    printf "x = %.5f\n" "$x"

else
    # D < 0
    echo "Võrrandil puuduvad reaalarvulised lahendid."
fi
